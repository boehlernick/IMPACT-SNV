{
  "name": "impact_snv_indel_vcf_merge",
  "title": "IMPACT SNV and InDel vcf merging",
  "summary": "Merges and annotates SNV and InDel vcf input files into chromosome-separated",
  "dxapi": "1.0.0",
  "version": "0.0.1",
  "inputSpec": [
    {
      "name": "input_vcfs",
      "label": "VCF or VCF.GZ files",
      "class": "array:file",
      "optional": false,
      "patterns": [
        "*.vcf",
        "*.vcf.gz"
      ],
      "help": "Input VCF files to be merged"
    },
    {
      "name": "index_files",
      "label": "Index files for VCF or VCF.GZ files",
      "class": "array:file",
      "optional": true,
      "patterns": [
        "*.tbi",
        "*.csi"
      ],
      "help": "Optional index files for the input VCF files"
    },
    {
      "name": "reference_genome",
      "label": "Reference Genome",
      "class": "file",
      "optional": false,
      "patterns": [
        "*.fa",
        "*.fasta"
      ],
      "help": "Reference genome file for normalization"
    }
  ],
  "outputSpec": [
    {
      "name": "merged_vcf",
      "label": "Merged VCF.GZ file output",
      "class": "file",
      "patterns": [
        "*.vcf.gz"
      ],
      "help": "Merged VCF file"
    },
    {
      "name": "split_vcfs",
      "label": "Chromosome-specific VCF.GZ files",
      "class": "array:file",
      "patterns": [
        "*.vcf.gz"
      ],
      "help": "VCF files split by chromosome"
    }
  ],
  "runSpec": {
    "timeoutPolicy": {
      "*": {
        "hours": 48
      }
    },
    "interpreter": "python3",
    "file": "src/IMPACT_SNV_indel.py",
    "distribution": "Ubuntu",
    "release": "20.04",
    "version": "0"
  },
  "regionalOptions": {
    "aws:us-east-1": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x36"
        }
      }
    },
    "aws:eu-west-2": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x36"
        }
      }
    }
  }
}